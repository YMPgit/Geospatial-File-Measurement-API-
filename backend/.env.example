# PostgreSQL connection string used by the backend.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/geospatial_db

# Maximum accepted upload size (megabytes). Enforced server-side.
MAX_UPLOAD_SIZE_MB=20

# Directory where uploaded files are stored on the filesystem.
UPLOAD_DIR=uploads

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# development | production | test
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
